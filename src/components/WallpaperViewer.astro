<!-- 独立的透明度层：不要和子组件的入场动画、菜单显隐争用 opacity。 -->
<div id="wallpaper-ui">
    <slot />
</div>
<div id="my-custom-bg" aria-hidden="true"></div>
<button id="wallpaper-exit" type="button" aria-label="退出赏图模式" hidden></button>

<!-- 样式与持久背景层放在一起，避免静态站点切页时被 head 替换移除。 -->
<style is:inline>
    #wallpaper-ui {
        isolation: isolate;
        opacity: 1;
        transition: opacity 0.5s ease-in-out;
    }

    body.bg-view-mode #wallpaper-ui {
        opacity: 0;
    }

    #my-custom-bg {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        opacity: 0.6;
        filter: blur(3px);
        transform: scale(1.02);
        transition: opacity 0.8s ease-in-out, filter 0.8s ease-in-out, transform 0.8s ease-in-out;
    }

    #my-custom-bg .wallpaper-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        opacity: 1;
    }

    body.bg-view-mode #my-custom-bg.loaded {
        opacity: 1;
        filter: blur(0);
        transform: scale(1);
    }

    /* 用透明按钮接管点击，背景始终留在底层，不切换 z-index。 */
    #wallpaper-exit {
        position: fixed;
        inset: 0;
        z-index: 9999;
        width: 100%;
        height: 100%;
        border: 0;
        padding: 0;
        background: transparent;
        outline: none;
        cursor: zoom-out;
    }

    @media (prefers-reduced-motion: reduce) {
        #wallpaper-ui,
        #my-custom-bg,
        #my-custom-bg .wallpaper-image {
            transition: none;
        }
    }
</style>

<script>
    const ui = document.getElementById('wallpaper-ui');
    const background = document.getElementById('my-custom-bg');
    const exitButton = document.getElementById('wallpaper-exit');

    // 生产构建可能内联此脚本，Swup 会在导航时重新执行；状态必须留在原实例。
    if (ui && background && exitButton && !background.dataset.wallpaperInitialized) {
        background.dataset.wallpaperInitialized = 'true';
        let previousFocus: HTMLElement | null = null;

        const setViewing = (viewing: boolean) => {
            if (viewing === document.body.classList.contains('bg-view-mode')) return;

            if (viewing) {
                previousFocus = document.activeElement instanceof HTMLElement
                    ? document.activeElement : null;
            }

            document.body.classList.toggle('bg-view-mode', viewing);
            ui.inert = viewing;
            exitButton.hidden = !viewing;

            if (viewing) {
                exitButton.focus({ preventScroll: true });
            } else if (previousFocus?.isConnected) {
                previousFocus.focus({ preventScroll: true });
            }
        };

        let currentImage: HTMLImageElement | null = null;
        let imageRequest = 0;
        let transitionComplete = Promise.resolve();
        let currentPage = location.pathname + location.search;

        const crossfade = async (image: HTMLImageElement) => {
            const previousImage = currentImage;
            background.append(image);
            currentImage = image;
            background.classList.add('loaded');

            // 下层旧图保持 opacity: 1，只让覆盖在上面的新图逐渐显现。
            // 逐帧动画不依赖外部样式表的加载时机，静态部署与开发环境一致。
            try {
                const animation = image.animate(
                    [{ opacity: 0 }, { opacity: 1 }],
                    {
                        duration: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 1000,
                        easing: 'ease-in-out',
                    },
                );
                await animation.finished;
            } catch {
                // 动画被取消或浏览器不支持时，保留已加载的新图。
            } finally {
                previousImage?.remove();
            }
        };

        const loadWallpaper = async () => {
            const request = ++imageRequest;
            const image = new Image();
            image.alt = '';
            image.className = 'wallpaper-image';
            image.decoding = 'async';
            image.src = `https://papi.bbcslook.top/?t=${Date.now()}-${request}`;

            // 直接展示同一张已解码的图片，避免随机接口被 CSS 再次请求。
            try {
                await image.decode();
            } catch {
                return;
            }
            // 快速连续导航时，等正在显示的过渡结束，再展示最新请求的图片。
            // 不移除仍在叠加中的图层，始终保留完整、不透明的底图。
            await transitionComplete;
            if (request !== imageRequest) return;
            transitionComplete = crossfade(image);
            await transitionComplete;
        };
        void loadWallpaper();

        document.addEventListener('dblclick', (event) => {
            if (!(event.target instanceof Element)) return;
            if (event.target.closest('a, button, img, input, textarea, select, [contenteditable], [role="button"]')) return;
            if (!background.classList.contains('loaded')) return;
            setViewing(true);
        });

        exitButton.addEventListener('click', () => setViewing(false));
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') setViewing(false);
        });

        // 浏览器前进/后退也可能在赏图时触发站内导航。
        const setupNavigation = () => {
            window.swup.hooks.on('visit:start', () => setViewing(false));
            window.swup.hooks.on('page:view', () => {
                const nextPage = location.pathname + location.search;
                if (nextPage === currentPage) return;
                currentPage = nextPage;
                void loadWallpaper();
            });
        };
        if (window.swup) setupNavigation();
        else document.addEventListener('swup:enable', setupNavigation, { once: true });
    }
</script>
